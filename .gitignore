
@'
# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging and build artifacts
build/
dist/
*.egg-info/

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local environment variables and secrets
.env
.env.*
!.env.example

# Temporary files and logs
*.log
*.tmp
*.bak
'@ | Set-Content -Encoding utf8 .gitignore
